@model IEnumerable<EmployeeLeaveManagementWeb.ViewModels.EmployeeVM.EmployeeListVM>

@{
    ViewData["Title"] = "Employees";
}

@await Html.PartialAsync("_QuickLinksPartial")

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="fw-bold mb-0">Employees</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> New Employee
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger d-flex align-items-center">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
    </div>
}
<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group" style="max-width: 400px;">
        <input type="text" name="search" value="@ViewData["CurrentSearch"]"
               class="form-control" placeholder="Search by name or email..." />
        <button type="submit" class="btn btn-outline-primary">
            <i class="bi bi-search"></i>
        </button>
        @if (!string.IsNullOrWhiteSpace(ViewData["CurrentSearch"] as string))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-x-lg"></i>
            </a>
        }
    </div>
</form>
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Department</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var employee in Model)
                {
                    <tr>
                        <td class="fw-semibold">@employee.FullName</td>
                        <td>@employee.Email</td>
                        <td>@employee.DepartmentName</td>
                        <td>
                            @{
                                var statusClass = employee.Status.ToString() == "Active"
                                    ? "bg-success-subtle text-success-emphasis"
                                    : "bg-secondary-subtle text-secondary-emphasis";
                            }
                            <span class="badge @statusClass">@employee.Status</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-info" title="Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-people fs-1 d-block mb-2"></i>
        @if (!string.IsNullOrWhiteSpace(ViewData["CurrentSearch"] as string))
        {
            <span>No employees found matching "@ViewData["CurrentSearch"]".</span>
        }
        else
        {
            <span>No employees found.</span>
        }
    </div>
}

@section Styles {
    <style>
        .quick-link {
            border-radius: 0.5rem;
            padding: 0.6rem 1.1rem;
        }

        .table > :not(caption) > * > * {
            padding: 0.85rem 1rem;
        }
    </style>
}