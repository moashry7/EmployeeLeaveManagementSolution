@model List<EmployeeLeaveManagementWeb.ViewModels.ReportVM.PendingApprovalReportVM>

@{
    ViewData["Title"] = "Pending Approvals Report";
}

@await Html.PartialAsync("_QuickLinksPartial")

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="fw-bold mb-0">Pending Approvals Report</h1>
    <a asp-action="PendingApprovalsReportPdf" class="btn btn-outline-danger">
        <i class="bi bi-file-earmark-pdf me-1"></i> Export PDF
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Leave Type</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Days Waiting</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    var waitClass = v.DaysWaiting >= 14 ? "text-danger fw-bold"
                        : v.DaysWaiting >= 7 ? "text-warning fw-bold"
                        : "";

                    <tr>
                        <td class="fw-semibold">@v.EmployeeName</td>
                        <td>@v.DepartmentName</td>
                        <td>@v.LeaveTypeName</td>
                        <td>@v.StartDate.ToString("yyyy-MM-dd")</td>
                        <td>@v.EndDate.ToString("yyyy-MM-dd")</td>
                        <td class="@waitClass">@v.DaysWaiting days</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-check-circle fs-1 d-block mb-2"></i>
        No pending requests.
    </div>
}