@model List<EmployeeLeaveManagementWeb.ViewModels.ReportVM.DepartmentReportVM>

@{
    ViewData["Title"] = "Department Report";
}

@await Html.PartialAsync("_QuickLinksPartial")

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="fw-bold mb-0">Department Headcount &amp; Budget Report</h1>
    <a asp-action="DepartmentReportPdf" class="btn btn-outline-danger">
        <i class="bi bi-file-earmark-pdf me-1"></i> Export PDF
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Department</th>
                    <th>Employees</th>
                    <th>Budget</th>
                    <th>Total Salaries</th>
                    <th>Remaining</th>
                    <th>Usage</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    var barClass = d.UsagePercent >= 90 ? "bg-danger"
                        : d.UsagePercent >= 70 ? "bg-warning"
                        : "bg-success";

                    <tr>
                        <td class="fw-semibold">@d.Name</td>
                        <td>@d.EmployeeCount</td>
                        <td>@d.Budget.ToString("C")</td>
                        <td>@d.TotalSalaries.ToString("C")</td>
                        <td class="@(d.RemainingBudget < 0 ? "text-danger fw-bold" : "")">
                            @d.RemainingBudget.ToString("C")
                        </td>
                        <td style="min-width: 120px;">
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar @barClass" style="width: @d.UsagePercent%"></div>
                            </div>
                            <small class="text-muted">@d.UsagePercent%</small>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>