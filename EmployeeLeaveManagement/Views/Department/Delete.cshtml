@model EmployeeLeaveManagementWeb.ViewModels.DepartmentVM.DepartmentDetailsVM

@{
    ViewData["Title"] = "Delete Department";
}

<h1>Delete Department</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this department?
</div>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Budget</dt>
    <dd class="col-sm-9">@Model.Budget.ToString("C")</dd>

    <dt class="col-sm-3">Employees</dt>
    <dd class="col-sm-9">@Model.EmployeeNames.Count</dd>
</dl>

@if (Model.EmployeeNames.Any())
{
    <div class="alert alert-danger">
        This department has employees and cannot be deleted until they are reassigned.
    </div>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
}
else
{
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
}