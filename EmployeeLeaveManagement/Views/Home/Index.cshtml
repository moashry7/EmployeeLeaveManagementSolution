@model EmployeeLeaveManagementWeb.ViewModels.HomeVM.DashboardVM
@{
    ViewData["Title"] = "Dashboard";
}

@await Html.PartialAsync("_QuickLinksPartial")

<div class="dashboard-header mb-4">
    <h1 class="fw-bold">Dashboard</h1>
    <p class="text-muted">Overview of the Employee &amp; Leave Management System</p>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="ms-3">
                    <h6 class="text-muted mb-1">Total Employees</h6>
                    <p class="stat-number mb-0">@Model.TotalEmployees</p>
                    <small class="text-muted">
                        <span class="text-success">@Model.ActiveEmployees active</span> ·
                        <span class="text-secondary">@Model.InactiveEmployees inactive</span>
                    </small>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>
                <div class="ms-3">
                    <h6 class="text-muted mb-1">Total Departments</h6>
                    <p class="stat-number mb-0">@Model.TotalDepartments</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div class="ms-3">
                    <h6 class="text-muted mb-1">Pending Leave Requests</h6>
                    <p class="stat-number mb-0">@Model.PendingLeaveRequests</p>
                    <small class="text-muted">
                        <span class="text-success">@Model.ApprovedLeaveRequests approved</span> ·
                        <span class="text-danger">@Model.RejectedLeaveRequests rejected</span>
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title fw-bold mb-3">Recent Leave Requests</h5>

                @if (Model.RecentLeaveRequests.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Employee</th>
                                    <th>Type</th>
                                    <th>Dates</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.RecentLeaveRequests)
                                {
                                    var statusClass = r.Status switch
                                    {
                                        "Approved" => "bg-success-subtle text-success-emphasis",
                                        "Rejected" => "bg-danger-subtle text-danger-emphasis",
                                        _ => "bg-warning-subtle text-warning-emphasis"
                                    };

                                    <tr>
                                        <td>@r.EmployeeName</td>
                                        <td>@r.LeaveTypeName</td>
                                        <td>@r.StartDate.ToString("MMM d") – @r.EndDate.ToString("MMM d")</td>
                                        <td><span class="badge @statusClass">@r.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <a asp-controller="LeaveRequest" asp-action="Index" class="btn btn-sm btn-outline-primary mt-3">
                        View All Requests
                    </a>
                }
                else
                {
                    <p class="text-muted mb-0">No leave requests yet.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title fw-bold mb-3">Department Budget Usage</h5>

                @if (Model.DepartmentBudgets.Any())
                {
                    @foreach (var d in Model.DepartmentBudgets)
                    {
                        var barClass = d.UsagePercent >= 90 ? "bg-danger"
                            : d.UsagePercent >= 70 ? "bg-warning"
                            : "bg-success";

                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-semibold">@d.Name</span>
                                <small class="text-muted">@d.UsagePercent%</small>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar @barClass" style="width: @d.UsagePercent%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">No departments yet.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .dashboard-header h1 {
            color: #212529;
        }

        .stat-card {
            border-radius: 1rem;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

            .stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 0.75rem 1.5rem rgba(0,0,0,0.08) !important;
            }

        .stat-icon {
            width: 56px;
            height: 56px;
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
        }
    </style>
}