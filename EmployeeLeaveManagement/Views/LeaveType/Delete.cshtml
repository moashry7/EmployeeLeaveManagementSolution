@model EmployeeLeaveManagementWeb.ViewModels.LeaveTypeVM.LeaveTypeDetailsVM

@{
    ViewData["Title"] = "Delete Leave Type";
}

@await Html.PartialAsync("_QuickLinksPartial")

<h1 class="fw-bold mb-4">Delete Leave Type</h1>

<div class="alert alert-warning d-flex align-items-center">
    <i class="bi bi-exclamation-triangle-fill me-2"></i>
    Are you sure you want to delete this leave type? This cannot be undone.
</div>

<div class="card border-0 shadow-sm" style="max-width: 500px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-5">Name</dt>
            <dd class="col-sm-7">@Model.Name</dd>

            <dt class="col-sm-5">Days Allowed Per Year</dt>
            <dd class="col-sm-7">@Model.DaysAllowedPerYear</dd>

            <dt class="col-sm-5">Leave Requests Using This Type</dt>
            <dd class="col-sm-7">@Model.LeaveRequestCount</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3">
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash me-1"></i> Delete
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>