@model EmployeeLeaveManagementWeb.ViewModels.LeaveTypeVM.LeaveTypeCreateVM

@{
    ViewData["Title"] = "New Leave Type";
}

@await Html.PartialAsync("_QuickLinksPartial")

<h1 class="fw-bold mb-4">New Leave Type</h1>

<div class="card border-0 shadow-sm" style="max-width: 500px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DaysAllowedPerYear" class="form-label"></label>
                <input asp-for="DaysAllowedPerYear" class="form-control" />
                <span asp-validation-for="DaysAllowedPerYear" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i> Save
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}