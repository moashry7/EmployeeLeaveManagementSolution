@model IEnumerable<EmployeeLeaveManagementWeb.ViewModels.LeaveTypeVM.LeaveTypeListVM>

@{
    ViewData["Title"] = "Leave Types";
}

@await Html.PartialAsync("_QuickLinksPartial")

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="fw-bold mb-0">Leave Types</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> New Leave Type
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger d-flex align-items-center">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Days Allowed Per Year</th>
                    <th>Leave Requests</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var leaveType in Model)
                {
                    <tr>
                        <td class="fw-semibold">@leaveType.Name</td>
                        <td>@leaveType.DaysAllowedPerYear</td>
                        <td>
                            <span class="badge bg-secondary-subtle text-secondary-emphasis">
                                @leaveType.LeaveRequestCount
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@leaveType.Id" class="btn btn-sm btn-outline-info" title="Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@leaveType.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@leaveType.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-tags fs-1 d-block mb-2"></i>
        No leave types found.
    </div>
}

@section Styles {
    <style>
        .table > :not(caption) > * > * {
            padding: 0.85rem 1rem;
        }
    </style>
}